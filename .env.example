NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/emr_appointments?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
APP_TIMEZONE=Asia/Kolkata
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
DEMO_USER_PASSWORD=replace-with-a-unique-demo-password-at-least-12-characters

